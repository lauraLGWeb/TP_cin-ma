    } catch(ex) {}
    try {
      window.parent.someRandomProperty
      return "Failed JS heap access check"
    } catch(ex) {}
    return "ok"
  }
  let result
  try {
    result = doIframeSecurityChecks()
  } catch(ex) {
    result = ex + ''
  }
  window.parent.postMessage({ pluginMessage: result }, '*')
